# Kilo local state
/.kilo/
/.kilo-tmp/

# Xcode and macOS local state
# Generated XcodeGen project except the tracked SwiftPM lockfile
/Sidekick.xcodeproj/*
!/Sidekick.xcodeproj/project.xcworkspace/
/Sidekick.xcodeproj/project.xcworkspace/*
!/Sidekick.xcodeproj/project.xcworkspace/xcshareddata/
/Sidekick.xcodeproj/project.xcworkspace/xcshareddata/*
!/Sidekick.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/Sidekick.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Sidekick.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
**/xcuserdata/
**/DerivedData/
.DS_Store

# Local build and test output
**/.build/
**/.swiftpm/
**/.test-tmp/
**/build/
**/Build/
**/*.xcresult
/dist/
*.txt
